# Agrinet backend environment — copy to `.env` and fill in real values.
# Never commit the real .env (it is gitignored).

# AWS region for DynamoDB (required)
AWS_REGION=us-east-1

# Only if not using IAM roles:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Secret used to sign JWT auth tokens. Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Registry service
REGISTRY_URL=
REGISTRY_API_KEY=

# Stripe secret key (use a test key locally: sk_test_...)
STRIPE_KEY=

UI_STRING=Fruitful_app
NODE_ID=backend-node-01
NODE_TYPE=backend

# Comma-separated exact browser origins allowed to call this API.
CORS_ALLOWED_ORIGINS=https://www.ntari.org

# Federation peer authentication (use random secrets of at least 32 characters).
# FEDERATION_LOCAL_NODE_ID=backend-node-01
# FEDERATION_LOCAL_PEER_SECRET=
# FEDERATION_PEERS_JSON={"peer-node-01":"replace-with-a-distinct-32-byte-secret"}

# Shared store for distributed rate limits (required for multiple server instances).
# REDIS_URL=redis://localhost:6379
# Set true in multi-instance deployments to fail startup if Redis is missing.
RATE_LIMIT_REDIS_REQUIRED=false
