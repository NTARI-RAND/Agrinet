# Copy to backend/.env and fill in real values. NEVER commit backend/.env —
# it is gitignored for a reason: this repo is public, and a real credential
# committed here is immediately harvested (it has happened; see security
# advisory #1).

# AWS DynamoDB region (required)
AWS_REGION=us-east-1

# If not using IAM roles, uncomment and provide access keys
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

JWT_SECRET=change-me-long-random-string
REGISTRY_URL=
REGISTRY_API_KEY=
STRIPE_KEY=
UI_STRING=
NODE_ID=
NODE_TYPE=
