{
  "root": true,
  "extends": "eslint:recommended",
  "env": { "es2022": true },
  "parserOptions": { "ecmaVersion": "latest", "sourceType": "module", "ecmaFeatures": { "jsx": true } },
  "ignorePatterns": ["**/node_modules/**", "**/.next/**", "**/dist/**"],
  "rules": { "no-unused-vars": ["error", { "args": "none", "varsIgnorePattern": "^_" }] },
  "overrides": [
    { "files": ["backend/**/*.js"], "env": { "node": true, "jest": true } },
    { "files": ["frontend/**/*.js", "frontend/**/*.jsx"], "env": { "browser": true } },
    { "files": ["**/*.config.js", "frontend/*.js", "frontend/chat-ui/*.js"], "env": { "node": true } }
  ]
}
