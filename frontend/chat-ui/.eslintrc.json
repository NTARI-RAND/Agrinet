{
  "extends": ["../../.eslintrc.json", "plugin:react-hooks/recommended"],
  "root": true,
  "env": { "browser": true },
  "plugins": ["react"],
  "rules": { "react/jsx-uses-react": "error", "react/jsx-uses-vars": "error" },
