# Agrinet chat-ui frontend environment — copy to `.env.local` and fill in real values.
# Never commit the real .env.local (it is gitignored).

# REST API base URL
VITE_API_BASE_URL=http://localhost:4000
VITE_API_KEY=

# AWS Amplify / AppSync (values come from your Amplify environment)
VITE_AMPLIFY_GRAPHQL_ENDPOINT=
VITE_AMPLIFY_API_KEY=
VITE_AMPLIFY_REGION=us-east-1

# Cognito
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=
