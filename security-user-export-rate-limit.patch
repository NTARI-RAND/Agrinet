++++ b/backend/sync/importHelper.js
+@@
+ const docClient = require('../lib/dynamodbClient');
+ const { LISTING_TABLE_NAME } = require('../models/listing');
+ const { TRANSACTION_TABLE_NAME } = require('../models/transaction');
+ const { USER_TABLE_NAME } = require('../models/user');
+
+ function sanitizeImportedUser(user) {
+   if (!user || typeof user !== 'object') {
+     throw new Error('Invalid user entry in federated import');
+   }
+
+   const {
+     id,
+     username,
+     email,
+     phone,
+     location,
+     coordinates,
+     locationType,
+     locationPrivacy,
+     reputationScore,
+     reputationWeight,
+     password,
+     verificationCode,
+     verified,
+     role,
+     ...rest
+   } = user;
+
+   if (!id) {
+     throw new Error('User import requires a user id');
+   }
+
+   const cleaned = {
+     id,
+     username,
+     email,
+     phone,
+     location,
+     coordinates,
+     locationType,
+     locationPrivacy,
+     reputationScore,
+     reputationWeight,
+     ...rest
+   };
+
+   delete cleaned.password;
+   delete cleaned.verificationCode;
+   delete cleaned.verified;
+   delete cleaned.role;
+
+   return cleaned;
+ }
+
+ async function importFederatedData(data) {
+   for (const listing of data.listings || []) {
+     await docClient.put({ TableName: LISTING_TABLE_NAME, Item: listing }).promise();
+   }
+   for (const transaction of data.transactions || []) {
+     await docClient.put({ TableName: TRANSACTION_TABLE_NAME, Item: transaction }).promise();
+   }
+   for (const user of data.users || []) {
+     const cleanedUser = sanitizeImportedUser(user);
+
+     const existing = await docClient.get({
+       TableName: USER_TABLE_NAME,
+       Key: { id: cleanedUser.id }
+     }).promise();
+
+     if (existing && existing.Item) {
+       throw new Error(`Refusing to overwrite existing user id: ${cleanedUser.id}`);
+     }
+
+     await docClient.put({
+       TableName: USER_TABLE_NAME,
+       Item: cleanedUser,
+       ConditionExpression: 'attribute_not_exists(id)'
+     }).promise();
+   }
+   return { success: true };
+ }
+
+ module.exports = { importFederatedData };
+
*** End Patch
